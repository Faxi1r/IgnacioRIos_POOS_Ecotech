# SQLite funciona sin instalar un servidor.
DB_ENGINE=sqlite
DB_NAME=ecotech_uml8.db

# Para MySQL, cambie DB_ENGINE a mysql y DB_NAME a ecotech_uml8.
# Cree esa base y conceda permisos a su usuario antes de ejecutar el programa.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ecotech_app
DB_PASSWORD=

# El script preparar_entorno.py genera una clave distinta para cada instalación.
ECOTECH_CLAVE_CIFRADO=GENERAR_CON_EL_SCRIPT
